# =============================================================================
#  branch: ab-test
#  Each session: land -> add 1-3 random products -> header CART -> View Cart.
#  Sticky "Check out" banner shown -> click it and complete the order with the
#  test card below. Only the primary "Check out" button -> exit.
#  Desktop only, 1920x1080 (the banner needs >=801px width), rotating
#  Chromium / Firefox / WebKit per session.
# =============================================================================

# --- Site ---
ORIGIN=https://noibudemo.com

# --- Scheduling ---
# 1 = back-to-back: the next session starts BACK_TO_BACK_GAP_MIN_S..MAX_S
#     seconds after a slot frees up. SESSIONS_PER_MINUTE is ignored.
# 0 = one session every 60/SESSIONS_PER_MINUTE seconds (0.0833333 = 5/hour,
#     ~12 min apart) with ±SCHEDULER_JITTER.
BACK_TO_BACK=1
BACK_TO_BACK_GAP_MIN_S=2
BACK_TO_BACK_GAP_MAX_S=5
SESSIONS_PER_MINUTE=0.0833333
SCHEDULER_JITTER=0.15
# How many sessions may run at the same time (1 = strictly one at a time).
MAX_CONCURRENCY=1
# Hard ceiling per session; a stuck session is killed after this many seconds.
SESSION_MAX_SECONDS=600

# --- Browser ---
# 1 = headless, 0 = show the browser window.
HEADLESS=1
# 1 = brand-new browser process per session; 0 = one shared browser per
# engine with a fresh context (cookies/storage/cache) per session.
BROWSER_PER_SESSION=1
# Engines to rotate through, one per session in turn: chromium, firefox,
# webkit (Safari's engine). All run desktop at 1920x1080 with a matching UA.
BROWSER_TYPES=chromium,firefox,webkit
# Pause after each page load (ms), so pages settle and Noibu records them.
POST_NAV_SETTLE_MIN_MS=2500
POST_NAV_SETTLE_MAX_MS=5000
LOCALES=en-US,en-CA,en-GB,fr-CA
TIMEZONES=America/Toronto,America/New_York,America/Vancouver,Europe/London

# --- A/B scenario ---
# Random number of products added per session (inclusive).
AB_TEST_PRODUCTS_MIN=1
AB_TEST_PRODUCTS_MAX=3
# How long to wait on the cart page for the sticky banner before counting
# the session as control.
AB_TEST_STICKY_WAIT_MS=6000
# [AB SUMMARY] every N finished sessions, or after this many minutes since
# the last one, plus a final summary on exit.
AB_SUMMARY_EVERY=5
AB_SUMMARY_MINUTES=30

# --- Traffic source for the landing page ---
# One source is picked per session by weight. It sets both the Referer header
# and matching utm_source; "direct" sends neither.
REFERRER_SOURCES=direct,google,bing,facebook,instagram
REFERRER_WEIGHTS=30,35,10,15,10
# utm_medium per source; anything not listed uses UTM_MEDIUM_DEFAULT.
REFERRER_UTM_MEDIUMS=google:organic,bing:organic,facebook:paid-social,instagram:paid-social
UTM_MEDIUM_DEFAULT=referral
UTM_CAMPAIGN_DEFAULT=trafficgen

# --- Logging ---
DEBUG=1

# --- Test card used when the sticky variant completes checkout ---
CARD_NUMBER=4111111111111111
CARD_EXPIRY=01/30
CARD_CVV=989
