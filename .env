# ── Noibu Traffic Generator Configuration ──

# Target site
ORIGIN=https://noibudemo.com

# Rate limiting - 1 order per 5 minutes
MIN_INTERVAL_SECONDS=300

# Browser
# Set to 0 to watch the browser in action, 1 for headless
HEADLESS=0

# Card details (BigCommerce test payment provider)
CARD_NUMBER=4111111111111111
CARD_EXPIRY=01/30
CARD_CVV=989

# Debug mode (set to 1 for verbose logging)
DEBUG=1
