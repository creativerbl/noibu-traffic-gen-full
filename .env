# =============================================================================
#  branch: ab-test (cut from broken-checkout)
#  FIVE sessions per hour (~every 12 min): land -> add 1-3 random products ->
#  header CART -> View Cart. Sticky "Check out" banner shown -> click it and
#  complete the order with the test card. Primary button only -> exit.
#  Desktop + mobile, Chrome only. Nothing else runs on this branch.
# =============================================================================

# --- Core traffic shaping: five sessions per hour ---
# 5/60 = 0.0833333 sessions per minute (~12 min apart). MAX_CONCURRENCY=1
# guarantees sessions never overlap even if one runs long.
SESSIONS_PER_MINUTE=0.0833333
AVG_SESSION_MINUTES=1
MAX_CONCURRENCY=1
GLOBAL_QPS_CAP=6
# ±15% jitter on the ~12 min interval (~10-14 min) so it isn't clockwork-exact.
SCHEDULER_JITTER=0.15
# 1 = fire the first session a few seconds after boot instead of waiting an
# interval. Set to 0 if you want the first session one full interval after start.
SCHEDULER_START_IMMEDIATELY=1
# 1 = back-to-back: ignore SESSIONS_PER_MINUTE and start the next session
# 2-5s after the previous one ends (MAX_CONCURRENCY=1 keeps it strictly one
# at a time). 0 = use the SESSIONS_PER_MINUTE cadence above.
BACK_TO_BACK=1
BACK_TO_BACK_GAP_MIN_S=2
BACK_TO_BACK_GAP_MAX_S=5
# Hard ceiling per session: up to 3 adds + full card checkout is ~3-4 min.
# 10 min keeps a stuck session from eating into the next 12 min slot.
SESSION_MAX_SECONDS=600
DESKTOP_SESSION_MULT=1.0
MOBILE_SESSION_MULT=1.0
# Never rotate the browser on a schedule — at five sessions/hour a rotation
# would just restart the scheduler and skew the cadence.
BROWSER_MAX_SESSIONS=0
# 1 = launch a brand-new Chromium process for every session (closed after).
# Doesn't restart the scheduler, so the ~12 min cadence is unaffected.
BROWSER_PER_SESSION=1
BROWSER_MAX_MINUTES=0

# --- A/B-test scenario ---
# Random number of products added per session (inclusive range).
AB_TEST_PRODUCTS_MIN=1
AB_TEST_PRODUCTS_MAX=3
# How long to wait on the cart page for the sticky checkout banner before
# treating the session as the control variant and exiting.
AB_TEST_STICKY_WAIT_MS=6000
# Print an [AB SUMMARY] (control vs sticky counts) every N finished sessions,
# or after this many minutes since the last summary, and once on exit.
AB_SUMMARY_EVERY=5
AB_SUMMARY_MINUTES=30

# --- Broken-checkout scenario (inactive on this branch; kept for reference) ---
# Products added to the cart before checkout.
BROKEN_CHECKOUT_PRODUCTS=3
# Payment method picked at random per session. bank = Bank Deposit,
# cod = Cash on Delivery (BigCommerce offline methods — no card fields).
BROKEN_CHECKOUT_PAYMENT_METHODS=bank,cod
# RETRIES after the first failed submission (inclusive random range).
# Total Place Order submissions per session = retries + 1, so 2-8.
BROKEN_CHECKOUT_RETRY_MIN=1
BROKEN_CHECKOUT_RETRY_MAX=7
# Seconds to wait between retry attempts (random per attempt).
BROKEN_CHECKOUT_RETRY_WAIT_MIN_S=5
BROKEN_CHECKOUT_RETRY_WAIT_MAX_S=20

# --- Flow isolation: only the ab-test scenario runs ---
FLOWS_ONLY=ab-test
# Personas OFF: an empty path loads no personas, so no bounce sessions and
# no persona funnel gating — every session runs the scenario end to end.
PERSONAS_FILE=
# The scenario needs 3 cart adds; the funnel cap would otherwise stop at 1.
FUNNEL_MAX_CART_ADDS_PER_SESSION=3
FUNNEL_MAX_CHECKOUT_STARTS_PER_SESSION=1
ALLOW_CHECKOUT=true
CHECKOUT_COMPLETE_RATE=0
# No random coverage-click pass on this branch.
COVERAGE_RUN_PROB=0

# --- Device mix: desktop Chrome only ---
# desktop-chrome = 1920x1080 (Full HD) Chrome UA. The sticky checkout banner only
# renders at >=801px wide (flag: 3393-desktop-cart-sticky-checkout-cta), so
# mobile sessions could never reach the variant; they are excluded here.
DEVICE_MIX=desktop-chrome:100

# --- Site ---
ORIGIN=https://noibudemo.com

# --- Locales & timezones ---
LOCALES=en-US,en-CA,en-GB,fr-CA
TIMEZONES=America/Toronto,America/New_York,America/Vancouver,Europe/London

# --- Flags ---
DEBUG=1
SMOKE=0
# 1 = headless, 0 = headed (watch the retries happen).
HEADLESS=1

# --- Referrers & UTM (personas are off, so these drive attribution) ---
REFERRER_HEADER_URLS=direct,https://www.google.com/,https://www.bing.com/,https://www.facebook.com/,https://www.instagram.com/
REFERRER_SOURCES=direct,google,bing,facebook,instagram
REFERRER_WEIGHTS=30,35,10,15,10
UTM_CAMPAIGN_DEFAULT=trafficgen
UTM_MEDIUM_DEFAULT=paid-social
REFERRER_UTM_MEDIUMS=google:organic,bing:organic

# --- Page readiness & realism ---
PAGE_WAIT_UNTIL=load              # load | domcontentloaded | networkidle
POST_NAV_SETTLE_MIN_MS=2500
POST_NAV_SETTLE_MAX_MS=5000
SCROLL_PROB=0.7
SCROLL_DEPTH_MIN=0.35
SCROLL_DEPTH_MAX=0.9
SCROLL_STEPS_MIN=2
SCROLL_STEPS_MAX=6

# --- Category weighting (used when picking the listing pages to shop from) ---
NAV_CATEGORY_WEIGHTS=Kitchen:35,Bath:30,Lighting:8,Furniture:7,Bedroom:6,Decor:5,Sale:3,New:3,All:3
NAV_HOTSPOT_NAMES=Kitchen,Bath
NAV_HOTSPOT_EXTRA_CLICK_PROB=Kitchen:0.65,Bath:0.45
NAV_NAVIGATION_PAUSE_MS_MIN=2500
NAV_NAVIGATION_PAUSE_MS_MAX=5000
CATEGORY_SORT_PROB=0.30
CATEGORY_FILTER_PROB=0.15

# --- Card details: UNUSED on this branch (bank/COD have no card fields).
#     Kept so the card path still works if you switch flows back on. ---
CARD_NUMBER=4111111111111111
CARD_EXPIRY=01/30
CARD_CVV=989
ORDER_MIN_INTERVAL_SECONDS=300
