# ── Supervised local test profile ──
# Usage: cp .env .env.prod-backup && cp .env.test .env
ORIGIN=https://noibudemo.com

# Slow trickle so you can watch individual sessions
SESSIONS_PER_MINUTE=2
AVG_SESSION_MINUTES=2
MAX_CONCURRENCY=2
GLOBAL_QPS_CAP=4

# Visible browser + verbose logs
HEADLESS=0
DEBUG=1

# Personas drive attribution + funnel
PERSONAS_FILE=trafficgen/personas.yaml

# Orders: allow one per minute during testing
ORDER_MIN_INTERVAL_SECONDS=60
CARD_NUMBER=4111111111111111
CARD_EXPIRY=01/30
CARD_CVV=989

# Page behavior (same as prod defaults)
PAGE_WAIT_UNTIL=load
POST_NAV_SETTLE_MIN_MS=1500
POST_NAV_SETTLE_MAX_MS=3000
SCROLL_PROB=0.7
SCROLL_DEPTH_MIN=0.35
SCROLL_DEPTH_MAX=0.9
SCROLL_STEPS_MIN=2
SCROLL_STEPS_MAX=6

LOCALES=en-US,en-CA
TIMEZONES=America/Toronto,America/New_York
DEVICE_MIX=iphone-safari:15,android-chrome:20,desktop-chrome:35,desktop-edge:10,desktop-safari:10,desktop-firefox:10
